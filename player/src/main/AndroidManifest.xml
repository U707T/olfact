<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android 11+ 包可见性：不声明的话 PackageManager.getPackageInfo / resolveActivity
      看不到设备上装的外部播放器（「用其他播放器打开」会永远提示没有可用播放器）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="cn.olfact.player.VideoPlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|layoutDirection|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Olfact.Player" />
    </application>
</manifest>
