<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Uikit.PageTitle" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/uikit_text_page_title</item>
        <item name="android:textColor">@color/uikit_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Uikit.Header" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/uikit_text_header</item>
        <item name="android:textColor">@color/uikit_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Uikit.Body" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/uikit_text_body</item>
        <item name="android:textColor">@color/uikit_text_primary</item>
    </style>

    <style name="TextAppearance.Uikit.Caption" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/uikit_text_small</item>
        <item name="android:textColor">@color/uikit_text_secondary</item>
    </style>

    <style name="TextAppearance.Uikit.Value" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/uikit_text_value</item>
        <item name="android:textColor">@color/uikit_text_secondary</item>
    </style>

    <style name="UikitSheetAnimation" >
        <item name="android:windowEnterAnimation">@anim/uikit_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/uikit_sheet_out</item>
    </style>

    <style name="UikitSheetDialog" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowAnimationStyle">@style/UikitSheetAnimation</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="WidgetUikitCard" >
        <item name="android:background">@drawable/uikit_bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
